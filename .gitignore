# Secrets — never commit
.env
.env.local
.env.*
!.env.example
creds.json
*.json.cred
tunnel-token.txt
# Any cloudflared tunnel credentials JSON (tunnel secret lives here)
deploy/cloudflared/*.json
# Next.js build manifests we don't track. The build emits a directory
# directly under _next/static named after a hash (e.g. zBalKiJkOu8iyyPtRKaTD
# or --dZSJv8SAw2cSOnACp7F) that holds only _buildManifest.js and
# _ssgManifest.js. Track the actual chunks (chunks/, css/) and the
# app shell. The pattern is anchored to the _next/static root so it
# doesn't accidentally sweep up legitimate subdirs (chunks/, css/).
api/ui/_next/static/_buildManifest.js
api/ui/_next/static/_ssgManifest.js
api/ui/_next/static/[!c]*/

# Go build output
bin/
*.exe
*.test
*.out
alpacaruns.linux
alpacaruns-darwin
alpacaruns-windows.exe

# Node (defensive — none used but harmless)
node_modules/
.next/
dist/
.vite/

# Dashboard build artifacts (the pre-built export lives at api/ui/;
# dashboard/out is just the intermediate).
dashboard/out/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Runtime data (state files, trade logs, uv caches)
data/

# Hackathon video intermediate artifacts (final mp4 stays tracked)
hackathon_video/build/
hackathon_video/slides/
hackathon_video/slide_audio/

# Misc
*.log
*.pem
*.key
*.crt
srv.log

# Local helper scripts & scratch
scratch/
tmp/
notes.md
TODO.md
AGENTS.local.md
*.bak
*.orig
*~
# Emacs / Vim autosaves / lockfiles
\#*\#
.\#*
*.swp