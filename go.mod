module github.com/BROCKUGANDA/alpacaruns

go 1.26.7

// Pinned above the patched Go release, not left to the builder's default.
// govulncheck traced 13 findings through reachable paths in the standard
// library of go1.26.7 — net/http and html/template behind
// api.Run's ListenAndServe, and crypto/x509 — fixed only in 1.26.9 and 1.26.10.
// With GOTOOLCHAIN=auto this makes every build of this module (including the
// cross-compile that produces the deployed binary) use the patched toolchain;
// without it, the fix depends on which Go happened to be installed.
toolchain go1.26.10

require (
	github.com/gorilla/websocket v1.5.3
	github.com/modelcontextprotocol/go-sdk v1.4.1
	google.golang.org/adk v1.6.0
	google.golang.org/genai v1.57.0
	modernc.org/sqlite v1.61.0
)

