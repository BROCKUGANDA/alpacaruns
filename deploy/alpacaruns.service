# /etc/systemd/system/alpacaruns.service
# Install:  sudo cp alpacaruns.service /etc/systemd/system/ && sudo systemctl daemon-reload
# Enable:   sudo systemctl enable --now alpacaruns
# Logs:     journalctl -u alpacaruns -f

[Unit]
Description=Alpacaruns autonomous paper-trading monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alpacaruns
Group=alpacaruns
WorkingDirectory=/opt/alpacaruns
EnvironmentFile=/opt/alpacaruns/.env
# The deterministic loop is the production path: it needs no LLM, so it
# runs 24/7 on a bare box. Use `alpacaruns monitor` instead when an LLM
# provider (llama.cpp / Oxlo / Gemini) is reachable and you want the
# agent cycle to drive decisions.
ExecStart=/usr/local/bin/alpacaruns auto
Restart=always
RestartSec=10
# Graceful shutdown: SIGTERM lets the monitor finish in-flight order polling.
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/alpacaruns/data
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
