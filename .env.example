# Alpacaruns config — PAPER TRADING ONLY
ALPACA_API_KEY_ID=<your-key-here>
ALPACA_SECRET_KEY=<your-key-here>
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# supervised = human approval before ExecutionExpert fires
# autonomous = proceeds only if risk passes AND confidence >= MIN_CONFIDENCE
MODE=supervised

POLL_SECONDS=300
MIN_CONFIDENCE=0.7
MAX_POSITION_USD=10000
MAX_PORTFOLIO_PCT=0.20

# ── Universal signal picker: the universe, by asset class ──────────────────
# Every list is a class. The picker classifies them, fetches the right
# data for each, and ranks them with the factor engine.
STRATEGY_EQUITY_SYMBOLS=AAPL,MSFT,NVDA
STRATEGY_ETF_SYMBOLS=SPY
STRATEGY_INDEX_SYMBOLS=QQQ,IWM
STRATEGY_CRYPTO_SYMBOLS=BTC/USD,ETH/USD
# Option underlyings are expanded into concrete contracts (the contract
# closest to the middle of the delta band inside the expiry window).
STRATEGY_OPTION_UNDERLYINGS=
OPTION_DELTA_MIN=0.60
OPTION_DELTA_MAX=0.70
OPTION_MIN_DTE=30
OPTION_MAX_DTE=45

# Execution windows (US/Eastern wall clock). Orders fire ONLY inside a
# window. Crypto trades 24/7 and uses CRYPTO_WINDOWS.
TRADING_WINDOWS=09:35-10:15,15:45-16:00
CRYPTO_WINDOWS=00:00-23:59

# ── Position-aware TP/SL ─────────────────────────────────────────────────────
# Protection is driven by what the broker reports as OPEN, not only by what
# this process placed. Every position is adopted into the level book and
# anchored to its REAL average entry price; equities get a resting
# take-profit/stop-loss pair at the broker (order_class=oco — a bracket with
# no entry leg), crypto and options are enforced locally because Alpaca has no
# order class for them.
#   true  adopt every position (default: an unprotected position is risk in
#         the account whether or not this bot opened it)
#   false adopt only positions inside the configured universe
TPSL_PROTECT_ALL=true

# Risk stops. A breach of any of them engages the shared kill switch.
DAILY_DD_HALT=0.05
WEEKLY_DD_HALT=0.10
TOTAL_DD_HALT=0.15

# ── Agent-to-agent bridge (off by default) ─────────────────────────────────
# Peer agents post signals to POST /api/a2a/signals with
# "Authorization: Bearer <A2A_TOKEN>". A signal NEVER places an order
# on its own: it goes through the same deterministic risk gate as the
# bot's own decisions, and the ramp decides what happens next.
#
#   off    signals are refused
#   shadow signals are accepted and scored, but no order is placed
#   on    signals reach the executor (an agent must first earn this
#         with A2A_SHADOW_PASSES consecutive approved shadow signals)
#
# A2A_TOKEN is REQUIRED when A2A_ENABLED=true — there is no anonymous
# mode. A2A_AGENTS is the allow-list of peer agent ids.
A2A_ENABLED=false
A2A_TOKEN=
A2A_AGENTS=
A2A_MODE=off
A2A_MAX_NOTIONAL=10000
A2A_SHADOW_PASSES=3
# Per-peer credentials, "agent:token,agent2:token2". Without them one shared
# token can post a signal as ANY allow-listed agent — including one ramped
# ON, whose signals execute. An agent listed here can only be impersonated
# by someone holding that agent's token; agents not listed keep using
# A2A_TOKEN. A malformed entry is a startup error, never silently skipped.
A2A_PEER_TOKENS=

# Dashboard API bearer token for the state-changing endpoints.
# Named operator credentials: "alice:token,bob:token". Attribution in the
# journal and per-name revocation; DASHBOARD_TOKEN remains the unnamed
# fallback. Use one or the other, or both during a transition.
DASHBOARD_TOKENS=
DASHBOARD_TOKEN=

# Gemini API key for the ADK LLM agents (used only if LLM_BASE_URL is empty)
GEMINI_API_KEY=<your-key-here>

# ── Local llama.cpp (takes precedence over Gemini when set) ─────────────────
# Start llama-server with --jinja so Qwen3's own tool-call template is used:
#   llama-server -m Qwen3-4B-Instruct-Q4_K_M.gguf --jinja -c 16384 --port 8080
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=qwen3.7b-instruct-q4_k_m


# Oxlo.ai cloud LLM provider (secret; never commit)
OXLO_API_KEY=<your-key-here>


# ── Learning: self-calibration from realized trades ─────────────────────────
# After LEARN_MIN_TRADES closed round-trips the bot recomputes, from its own
# results, three things about how it trades: the entry score floor (which it
# may only RAISE), the position size per asset class (which it may only
# SHRINK), and the stop distance (which it may only TIGHTEN). It may also
# quarantine a symbol that keeps losing. No learned value can increase risk;
# a mis-calibrated estimate makes the bot trade less, never more.
#
# Off by default: an autonomous parameter change should be a deliberate act,
# and the engine needs a real trade history before any estimate is worth
# applying. Evidence is recorded either way, so turning this on later starts
# from data rather than from zero.
LEARN_ENABLED=false
# Closed trades required before the first adjustment.
LEARN_MIN_TRADES=12
# Recalibrate after every N further closed trades (not on a timer).
LEARN_EVERY_TRADES=5
# Floor on how far sizing may shrink: 0.25 means never below a quarter size.
LEARN_MIN_SIZE_MULTIPLIER=0.25
# Floor on how far a stop may be tightened: 0.75 means at most 25% tighter.
LEARN_MAX_TIGHTEN_FACTOR=0.75
# Quarantine a symbol at or below this win rate once it has
# LEARN_QUARANTINE_TRADES closed trades.
LEARN_QUARANTINE_WIN_RATE=0.25
LEARN_QUARANTINE_TRADES=6
# An asset class needs this many samples before its size or stop may move.
LEARN_MIN_SAMPLES_PER_CLASS=8
# Score buckets in the calibration table the dashboard shows.
LEARN_SCORE_BUCKETS=5

# ── Self-heal: repair the states the bot falls into by itself ───────────────
# Enabled by default. The most common degraded state is a protective order
# still resting over a position that no longer exists, which is a short sale
# waiting to fill. The pass may only CANCEL orders, re-base the drawdown
# high-water mark, or report — it never places an order and never widens a
# stop, so a bug in it cannot invent exposure.
SELFHEAL_ENABLED=true
# Run every N ticks (a tick is POLL_SECONDS), so the broker reads stay cheap.
SELFHEAL_EVERY_TICKS=6
# Find and journal, but change nothing. Use this for a first week of
# observation before letting it act.
SELFHEAL_REPORT_ONLY=false
# Cancel the bot's own unfilled entry orders older than this (hours).
# 0 disables the check.
SELFHEAL_ORPHAN_MAX_AGE_HOURS=24
# Lifting a drawdown halt automatically is a judgement call, so it is opt-in:
# when true the pass re-bases the drawdown peak once the breach has healed.
SELFHEAL_LIFT_HALT=false

# Pin for the Alpaca MCP server the LLM agents launch via uvx. The risk guard
# classifies tool NAMES, so the version is part of the safety surface: leave
# it unset to use the vetted default in agents.DefaultMCPServerSpec, and set
# it only after reading the new build's tool manifest.
ALPACA_MCP_SPEC=alpaca-mcp-server==2.4.0

# Keep a verified SQLite mirror of the journal and state (default true). The
# files remain the write path; the database is the queryable view, verified
# against them by `alpacaruns mirror` and every tenth tick.
SQLITE_MIRROR=true

# OIDC operator authentication (all three or none). When set, the control
# endpoints accept an RS256 JWT from this issuer and record its email as the
# acting operator. DASHBOARD_TOKENS keeps working for bootstrap.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Market-cap screen for single-name equities (0 = off). Caps come from
# `alpacaruns caps --refresh` (SEC EDGAR shares x broker close). ETFs, index
# trackers and crypto are exempt by class: a fund has AUM, a pair has no shares.
MIN_MARKET_CAP_USD=0
MAX_MARKET_CAP_USD=0
MARKET_CAP_MAX_AGE_DAYS=7
# Identity for the SEC's required User-Agent.
EDGAR_USER_AGENT=alpacaruns research (you@example.com)

# Live liquidity and margin limits. Spread is a filter (0 = off); gross
# exposure is the book-wide ceiling as a share of equity (1.0 = no leverage).
MAX_SPREAD_BPS=0
MAX_GROSS_EXPOSURE_PCT=1.0

# Rest-of-hours (extended session) trading. Off by default, and enabling it
# requires a spread cap in either MAX_SPREAD_BPS or
# EXTENDED_HOURS_MAX_SPREAD_BPS — the config refuses the combination.
#
# What the broker allows here is narrower than the regular session, and every
# line below is a measured Alpaca refusal, not a preference: an
# extended-hours order must be a limit with tif day|gtc, and bracket or OCO
# orders are refused outright (403). So a position OPENED IN THIS SESSION HAS
# NO BROKER STOP while it is there. Entries are still protected the moment the
# next regular session's protective pair is placed, and a stop breach in the
# extended session is exited by the bot crossing the bid itself — a market or
# stop order would be refused.
EXTENDED_HOURS=false
# When entries may open inside the extended session, US/Eastern. Deliberately
# narrower than the venue's 04:00-09:30 / 16:00-20:00: the first and last
# minutes are where the quote is thinnest.
EXTENDED_HOURS_WINDOWS=04:30-09:25,16:05-19:55
# Liquidity bar for this session (0 = fall back to MAX_SPREAD_BPS).
EXTENDED_HOURS_MAX_SPREAD_BPS=40
# A snapshot keeps serving its last print after the session ends (measured on a
# Sunday: a Friday 20:00:03Z quote, 10% wide). Anything older than this is not
# a market, and both entries and exits are refused on it.
EXTENDED_HOURS_MAX_QUOTE_AGE_SECONDS=300

# Per-class composite floors. Unset classes use FACTOR_MIN_SCORE. One floor
# calibrated on equities is not neutral for crypto.
FACTOR_MIN_SCORE_EQUITY=
FACTOR_MIN_SCORE_ETF=
FACTOR_MIN_SCORE_INDEX=
FACTOR_MIN_SCORE_CRYPTO=
FACTOR_MIN_SCORE_OPTION=
