# Alpacaruns config — PAPER TRADING ONLY
ALPACA_API_KEY_ID=<your-key-here>
ALPACA_SECRET_KEY=<your-key-here>
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# supervised = human approval before ExecutionExpert fires
# autonomous = proceeds only if risk passes AND confidence >= MIN_CONFIDENCE
MODE=supervised

POLL_SECONDS=300
MIN_CONFIDENCE=0.7
MAX_POSITION_USD=10000
MAX_PORTFOLIO_PCT=0.20

# ── Universal signal picker: the universe, by asset class ──────────────────
# Every list is a class. The picker classifies them, fetches the right
# data for each, and ranks them with the factor engine.
STRATEGY_EQUITY_SYMBOLS=AAPL,MSFT,NVDA
STRATEGY_ETF_SYMBOLS=SPY
STRATEGY_INDEX_SYMBOLS=QQQ,IWM
STRATEGY_CRYPTO_SYMBOLS=BTC/USD,ETH/USD
# Option underlyings are expanded into concrete contracts (the contract
# closest to the middle of the delta band inside the expiry window).
STRATEGY_OPTION_UNDERLYINGS=
OPTION_DELTA_MIN=0.60
OPTION_DELTA_MAX=0.70
OPTION_MIN_DTE=30
OPTION_MAX_DTE=45

# Execution windows (US/Eastern wall clock). Orders fire ONLY inside a
# window. Crypto trades 24/7 and uses CRYPTO_WINDOWS.
TRADING_WINDOWS=09:35-10:15,15:45-16:00
CRYPTO_WINDOWS=00:00-23:59

# ── Position-aware TP/SL ─────────────────────────────────────────────────────
# Protection is driven by what the broker reports as OPEN, not only by what
# this process placed. Every position is adopted into the level book and
# anchored to its REAL average entry price; equities get a resting
# take-profit/stop-loss pair at the broker (order_class=oco — a bracket with
# no entry leg), crypto and options are enforced locally because Alpaca has no
# order class for them.
#   true  adopt every position (default: an unprotected position is risk in
#         the account whether or not this bot opened it)
#   false adopt only positions inside the configured universe
TPSL_PROTECT_ALL=true

# Risk stops. A breach of any of them engages the shared kill switch.
DAILY_DD_HALT=0.05
WEEKLY_DD_HALT=0.10
TOTAL_DD_HALT=0.15

# ── Agent-to-agent bridge (off by default) ─────────────────────────────────
# Peer agents post signals to POST /api/a2a/signals with
# "Authorization: Bearer <A2A_TOKEN>". A signal NEVER places an order
# on its own: it goes through the same deterministic risk gate as the
# bot's own decisions, and the ramp decides what happens next.
#
#   off    signals are refused
#   shadow signals are accepted and scored, but no order is placed
#   on    signals reach the executor (an agent must first earn this
#         with A2A_SHADOW_PASSES consecutive approved shadow signals)
#
# A2A_TOKEN is REQUIRED when A2A_ENABLED=true — there is no anonymous
# mode. A2A_AGENTS is the allow-list of peer agent ids.
A2A_ENABLED=false
A2A_TOKEN=
A2A_AGENTS=
A2A_MODE=off
A2A_MAX_NOTIONAL=10000
A2A_SHADOW_PASSES=3

# Dashboard API bearer token for the state-changing endpoints.
DASHBOARD_TOKEN=

# Gemini API key for the ADK LLM agents (used only if LLM_BASE_URL is empty)
GEMINI_API_KEY=<your-key-here>

# ── Local llama.cpp (takes precedence over Gemini when set) ─────────────────
# Start llama-server with --jinja so Qwen3's own tool-call template is used:
#   llama-server -m Qwen3-4B-Instruct-Q4_K_M.gguf --jinja -c 16384 --port 8080
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=qwen3.7b-instruct-q4_k_m


# Oxlo.ai cloud LLM provider (secret; never commit)
OXLO_API_KEY=<your-key-here>
